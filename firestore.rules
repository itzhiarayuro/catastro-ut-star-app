rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Security Hardening: Permitir acceso SÓLO si el usuario está autenticado por Firebase Auth real
    function isAuthenticated() {
      return request.auth != null;
    }

    // Lectura pública para permitir acceso desde Excel/Power Query (REST API sin auth)
    // Escritura sigue protegida con autenticación
    match /fichas/{id} {
        allow read: if true;
        allow write: if isAuthenticated();
    }
    
    match /historial_fichas/{id} {
        allow read, write: if isAuthenticated();
    }
    
    match /marcaciones/{id} { 
        allow read: if true;
        allow write: if isAuthenticated();
    }
    
    match /historial_marcaciones/{id} {
        allow read, write: if isAuthenticated();
    }
    
    match /fichas_disenos/{id} { 
        allow read: if isAuthenticated();
        allow write: if isAuthenticated(); 
    }

    match /tuberias/{id} { allow read, write: if isAuthenticated(); }
    match /fotos/{id} { allow read, write: if isAuthenticated(); }
    match /ficha_available_fields/{id} { allow read, write: if isAuthenticated(); }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
